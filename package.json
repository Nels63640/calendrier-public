{
  "name": "family-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @family-calendar/web",
    "build": "npm run typecheck && npm run build --workspace @family-calendar/web",
    "preview": "npm run preview --workspace @family-calendar/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.sw.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run lint && npm run build && npm test",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "npm run build:local-test && npm run build:auth-test && playwright test",
    "push:setup": "node scripts/push-proof/setup.ts",
    "push:proof": "node scripts/push-proof/start.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build:auth-test": "npm run build --workspace @family-calendar/web -- --mode auth-test",
    "build:local-test": "npm run build --workspace @family-calendar/web -- --mode local-test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/web-push": "3.6.4",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.0.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "web-push": "3.6.7"
  }
}
